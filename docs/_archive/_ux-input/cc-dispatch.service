[Unit]
Description=Code&Craft autonomous dispatch supervisor (self-healing drain loop)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/cc-dispatch-loop JOB0003
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
